# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-only configuration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta / WhatsApp server-only configuration
META_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=your-random-webhook-verify-token
WHATSAPP_API_VERSION=v23.0

# Only for local/manual simulator use when needed
ALLOW_WHATSAPP_TEST_ROUTE=false
